    "chess.js": "^1.4.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "katex": "^0.18.1",
    "lucide-react": "^0.468.0",
    "react": "^19.2.8",
    "react-chessboard": "^5.10.0",
    "react-dom": "^19.2.8",
